# 华为云 API 访问密钥
HUAWEI_AK=your_access_key
HUAWEI_SK=your_secret_key
HUAWEI_REGION=ap-southeast-1

# DNS 记录类型和每条记录写入的优选 IP 数量
DNS_RECORD_TYPE=A
DNS_RECORD_COUNT=1

# 多域名记录配置文件，推荐复制 dns_records.example.json 为 dns_records.json 后填写。
DNS_RECORDS_FILE=dns_records.json

# 单域名兼容配置：如果没有 dns_records.json，脚本会使用下面三项。
# 需要先在华为云 DNS 控制台创建好 A/AAAA 记录，再复制对应的 zone_id 和 recordset_id。
DNS_ZONE_ID=your_zone_id
DNS_RECORDSET_ID=your_recordset_id
DNS_RECORD_NAME=example.com
DNS_TTL=300

# 飞书自定义机器人 Webhook
FEISHU_WEBHOOK_URL_CFST=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx

# IP 来源：cfhub（单次同步后退出，由 cron 调度）或 cfst（本地 CloudflareSpeedTest）
IP_SOURCE=cfhub
CFHUB_POOLS_URL=https://cfhub.1molchuan.top/api/v1/pools
RUN_STATE_FILE=run_state.json

# CloudflareSpeedTest 可执行文件配置
# Windows 本地存在 ./cfst_windows_amd64/cfst.exe 时可以留空。
# Linux 示例：CFST_BINARY=/opt/cfst/cfst
CFST_BINARY=
CFST_WORKDIR=
CFST_RESULT_CSV=cfst_result.csv

# CFST 测速参数
# -dn：延迟排序后继续进行下载测速的 IP 数量。
# -dt：单个 IP 下载测速的最长秒数。
# -tl：平均延迟上限，单位 ms。
# -sl：下载速度下限，单位 MB/s；0.01 可过滤不可用的回源 IP。
CFST_DOWNLOAD_COUNT=10
CFST_DOWNLOAD_SECONDS=10
CFST_MAX_LATENCY_MS=9999
CFST_MIN_SPEED_MB=0.01
CFST_EXTRA_ARGS=
CFST_TIMEOUT_SECONDS=3600

# 设置为 true 时仅打印将要更新的记录，不调用华为云 DNS 更新接口。
DRY_RUN=false
